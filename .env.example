# Copy to .env and fill in real values. Never commit .env.

# ── Required ──────────────────────────────────────────────
BOT_TOKEN=123456789:replace-with-your-token-from-BotFather

# Only these numbers can use the bot (comma separated)
ALLOWED_PHONES=0911111111,0922222222

# Who owns which account (first person = main earner). Format: phone:Bank,Bank;phone:Bank
ACCOUNTS=0911111111:Ahadu,Awash,CBE,telebirr,Dashen;0922222222:CBE,telebirr

# Display names (used until each person registers)
NAMES=0911111111:Partner A,0922222222:Partner B

# ── Time ──────────────────────────────────────────────────
TIMEZONE=Africa/Addis_Ababa

# ── Webhook mode (optional) ───────────────────────────────
# Leave WEBHOOK_URL empty to use polling (works on any VPS, no domain needed).
# For webhook mode: point a domain at the VPS, then set the values below and
# run:  docker compose --profile webhook up -d
DOMAIN=
WEBHOOK_URL=
WEBHOOK_SECRET=change-me-to-a-long-random-string
